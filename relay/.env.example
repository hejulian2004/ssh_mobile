# A DNS A/AAAA record for this host must point to the Docker host before Caddy
# can obtain a public certificate. Production uses a bare host with no scheme
# or path; isolated local smoke tests may use an explicit http:// loopback URL.
RELAY_PUBLIC_DOMAIN=relay.example.com
# Public origin advertised in RelayReserveResponse.relay_data_endpoint. Set the
# externally reachable HTTPS/WSS origin; local E2E alone may use loopback HTTP.
RELAY_PUBLIC_URL=

# Host-facing ports and image versions.
RELAY_HTTP_PORT=80
RELAY_HTTPS_PORT=443
RELAY_CADDY_IMAGE=caddy:2.8-alpine

# Internal container ports. Keep these aligned with the service contracts.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
RELAY_INTERNAL_PORT=8080
FRONT_INTERNAL_PORT=80

# Relay runtime limits. Durations use Go time.ParseDuration syntax.
# Storage backend: "mysql" (the bundled Compose default) or "memory" (local
# development only). mysql enables durable enrollment/revocation and requires
# both RELAY_DATABASE_URL (with parseTime=true&loc=UTC) and RELAY_REDIS_URL.
RELAY_STORAGE_MODE=mysql
RELAY_DATABASE_URL=relay:replace-with-a-random-relay-mysql-password@tcp(mysql:3306)/relay?parseTime=true&loc=UTC
# Shared state layer (presence, nonce, events); the bundled Compose stack
# starts Redis by default and passes this password separately from the URL.
RELAY_REDIS_URL=redis://redis:6379/0
# Generate an independent random value of at least 16 characters; Relay passes
# it separately so credentials do not appear in the Redis URL.
RELAY_REDIS_PASSWORD=
# Stable per-instance identity for presence; defaults to a random value.
RELAY_INSTANCE_ID=
RELAY_PRESENCE_TTL=60s
# MySQL container credentials (always-on Relay storage services).
MYSQL_ROOT_PASSWORD=replace-with-a-random-relay-mysql-root-password
MYSQL_DATABASE=relay
MYSQL_USER=relay
MYSQL_PASSWORD=replace-with-a-random-relay-mysql-password
RELAY_CREDENTIAL_TTL=24h
# Optional production TURN REST issuer. Keep the shared secret server-only;
# clients receive only the bounded credential response.
RELAY_TURN_URL=
RELAY_TURN_SHARED_SECRET=
RELAY_TURN_CREDENTIAL_TTL=5m
RELAY_MAX_CONNECTIONS=2048
RELAY_MAX_ENROLLED_DEVICES=4096
RELAY_MAX_REVOKED_DEVICES=4096
RELAY_MAX_TRANSFER_SESSIONS=4096
RELAY_MAX_PENDING_FRAMES_PER_DEVICE=64
RELAY_MAX_PENDING_BYTES_PER_DEVICE=16777216
RELAY_MAX_FRAMES_PER_SECOND_PER_DEVICE=256
RELAY_MAX_BYTES_PER_SECOND_PER_DEVICE=67108864
RELAY_HTTP_READ_TIMEOUT=15s
RELAY_HTTP_WRITE_TIMEOUT=15s
RELAY_HTTP_IDLE_TIMEOUT=60s
RELAY_HTTP_MAX_HEADER_BYTES=16384

# Comma-separated CIDRs whose requests the relay trusts to forward the real
# client address in X-Relay-Client-Addr. Empty (the default) never honors the
# forwarding header and uses RemoteAddr directly. In the bundled Compose
# topology this must match the Caddy container's static address in compose.yaml.
RELAY_TRUSTED_PROXY_CIDRS=172.30.0.10/32
# Optional isolated-network overrides for local E2E projects. Keep the defaults
# in sync with the static Caddy address above for normal deployments.
RELAY_NETWORK_SUBNET=172.30.0.0/24
RELAY_CADDY_IP=172.30.0.10

# Create the secrets with a cryptographically secure random generator. Never
# commit the real .env file or reuse these example values.
RELAY_ENROLLMENT_TOKEN=
RELAY_CREDENTIAL_KEY=
RELAY_INTERNAL_TOKEN=

# --- Analytics / Telemetry backend (admin-api telemetry ingest) ---
# These feed the admin-api telemetry ingest (`cmd/admin`) which writes durable
# events to analytics-mysql and buffers through analytics-redis. Replace these
# placeholders with the same generated credentials supplied to Compose; there
# are no bundled analytics password defaults.
TELEMETRY_MYSQL_DSN=telemetry:replace-with-analytics-mysql-password@tcp(analytics-mysql:3306)/telemetry?parseTime=true&loc=UTC
TELEMETRY_REDIS_URL=redis://:replace-with-analytics-redis-password@analytics-redis:6379/0
# Required for the telemetry auth/policy endpoints. Generate an independent
# random value (e.g. `openssl rand -base64 32`).
TELEMETRY_AUTH_SECRET=replace-with-a-random-telemetry-auth-secret
# Bounded public telemetry ingest controls. Values outside the safe hard limits
# are clamped; defaults are 1 MiB body, 100 records, 4 DB writers, and a
# 10-request-per-device burst with one token refilled per second.
TELEMETRY_MAX_BODY_BYTES=1048576
TELEMETRY_MAX_BATCH_SIZE=100
TELEMETRY_MAX_CONCURRENT_WRITERS=4
TELEMETRY_RATE_LIMIT_CAPACITY=10
TELEMETRY_RATE_LIMIT_REFILL_PER_SECOND=1
TELEMETRY_RATE_LIMIT_MAX_DEVICES=4096
TELEMETRY_RATE_LIMIT_DEVICE_TTL=10m
TELEMETRY_RETRY_AFTER_SECONDS=1
# Analytics container credentials (used by the optional "storage" Compose profile).
ANALYTICS_MYSQL_PASSWORD=replace-with-analytics-mysql-password
ANALYTICS_MYSQL_ROOT_PASSWORD=replace-with-analytics-mysql-root-password
ANALYTICS_REDIS_PASSWORD=replace-with-analytics-redis-password-of-at-least-16-characters
